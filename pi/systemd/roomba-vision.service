# SweepSense: reconocimiento de objetos con el Coral y la cámara (bonus, D12).
# Se instala pero queda DESHABILITADO. Para prenderlo:  sudo systemctl enable --now roomba-vision
# instalar_pi.sh cambia @USUARIO@ y @CARPETA@ por los de la Pi y lo copia a /etc/systemd/system/
[Unit]
Description=SweepSense vision con Coral (bonus)
After=mosquitto.service
Wants=mosquitto.service

[Service]
User=@USUARIO@
WorkingDirectory=@CARPETA@/servidor
Environment=PYTHONUNBUFFERED=1
ExecStart=@CARPETA@/servidor/.venv/bin/python vision_coral.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
